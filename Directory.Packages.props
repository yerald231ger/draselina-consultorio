<Project>
  <!-- Solo paquetes de la tabla Stack de la arquitectura. La gestión central se activa en Directory.Build.props. -->
  <ItemGroup>
    <!-- Aspire 13.6.5 (de 13.6.0 por los avisos de seguridad GHSA-f7vh-h5g3-7jrh y GHSA-4g86-54fm-h9h8, 2026-11-17). El SDK del AppHost fija su propia versión en el .csproj (Aspire.AppHost.Sdk/13.6.5). -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
    <!-- Mailpit en el AppHost: atrapa los correos en local y los muestra desde el dashboard (épica 4, Gerardo,
         2026-11-08). La del Community Toolkit que pide Aspire.Hosting 13.6.0. -->
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.MailPit" Version="13.6.0" />
    <!-- Paquetes de la plantilla ServiceDefaults de Aspire 13.6.0; los de Microsoft.Extensions, en la línea de .NET 11. -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <!-- EF Core 11.0.0, en línea con .NET 11. Npgsql en 11.0.0-rc.3 mientras no salga su 11.0 definitiva (Gerardo,
         2026-11-18): es el único paquete preliminar; se cambia en cuanto salga. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
    <!-- Identity en el host (AD-22, AD-25): cuentas en el esquema identidad, segundo factor TOTP. La misma línea que
         ASP.NET Core 11 (épica 5, entrada 1). -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="11.0.0" />
    <!-- El QR del enrolamiento del segundo factor, como SVG generado en el servidor, sin scripts. MIT (Gerardo,
         2026-11-09). -->
    <PackageVersion Include="QRCoder" Version="1.7.0" />
    <!-- Decoradores de los handlers en el host (AD-12, AD-22). La versión que usa Cypma.Cop. -->
    <PackageVersion Include="Scrutor" Version="6.1.0" />
    <!-- Valida y normaliza a E.164 los celulares de México (fila del Stack). Lo usa Pacientes.Features: el dominio y
         los contratos solo usan la biblioteca base (T-28, AD-12). -->
    <PackageVersion Include="libphonenumber-csharp" Version="9.0.42" />
    <!-- El canal SMTP de INotificationChannel (Notificaciones.Infrastructure), hacia Mailpit en local. Azure
         Communication Services también acepta SMTP, pero al desplegar habría que agregar la autenticación, que hoy
         no existe (Gerardo, 2026-11-08). -->
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <!-- Solo en pruebas. La misma línea que ASP.NET Core 11. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <!-- Solo en pruebas: pinta los componentes de UI/ sin navegador, en SSR estático y en interactivo
         (UI.Tests). Agregado con la historia de errores en el formulario (épica plataforma base, entrada 9). -->
    <PackageVersion Include="bunit" Version="2.11.3" />
  </ItemGroup>
</Project>
