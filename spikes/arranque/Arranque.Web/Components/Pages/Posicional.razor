@page "/posicional"
@inject IMessageBus Bus

<h1>Forma C: record posicional</h1>

<EditForm EditContext="contexto" FormName="registrar-nota" OnSubmit="Enviar">
    <label>Texto <InputText Value="@Comando!.Texto" ValueExpression="() => Comando!.Texto" /></label>
    <ValidationMessage For="() => Comando!.Texto" />
    <button type="submit">Guardar</button>
</EditForm>

<Estado Envio="envio" />

@code {
    [SupplyParameterFromForm] private RegistrarNotaPosicional? Comando { get; set; }

    private readonly Envio envio = new();
    private EditContext contexto = default!;
    private ValidationMessageStore mensajes = default!;

    protected override void OnInitialized()
    {
        Comando ??= new RegistrarNotaPosicional(Texto: null);
        contexto = new EditContext(Comando);
        mensajes = new ValidationMessageStore(contexto);
    }

    private Task Enviar() => envio.Enviar(Bus, Comando!, contexto, mensajes);
}
