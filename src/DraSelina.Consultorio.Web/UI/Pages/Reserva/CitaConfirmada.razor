@using DraSelina.Consultorio.Agenda.Contracts

@*
    Cita confirmada (mockup Confirmada): fecha y hora en grande, tipo y duración, lugar y dirección, el Enlace de
    gestión con "Guarda este enlace" (FR-5, AD-19), "Agregar a mi calendario" y "Volver al inicio". Se pinta en la misma respuesta del envío de Tus datos, sin redirección: así ninguna dirección lleva el id
    de la Cita.

    "Agregar a mi calendario" es un vínculo, sin scripts, al archivo de calendario bajo el Enlace de gestión
    (/c/<token>/calendario.ics, armado con el token), relativo al sitio que sirvió la página; va después de la tarjeta, con o sin correo.

    El enlace va completo como texto seleccionable; sin scripts no hay botón "Copiar". El "2 horas" sale del umbral de
    las reglas de reserva. Con correo no hay todavía frase del correo ni del recordatorio: nada se envía hasta la
    épica 4. Con o sin correo lo dice Pacientes (el Paciente puede tener uno guardado de antes). Sin correo, la frase de "sin correo" y el panel del enlace sube antes de la tarjeta (EXPERIENCE.md,
    "Confirmada, sin correo").
*@

<section class="dsm-contenedor dsm-confirmada" aria-labelledby="cita-confirmada">
    <div class="dsm-confirmada__encabezado">
        <div class="dsm-confirmada__icono">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12.5l4.5 4.5L19 7.5"></path>
            </svg>
        </div>
        <h1 id="cita-confirmada" class="dsm-titulo-de-estado">Tu cita está confirmada</h1>
        @if (!Cita.ConCorreo)
        {
            <p class="dsm-confirmada__nota">No recibirás recordatorio. Guarda este enlace o agrega la cita a tu calendario.</p>
        }
    </div>

    @if (!Cita.ConCorreo)
    {
        @Enlace
    }

    <div class="dsm-tarjeta">
        <div class="dsm-tarjeta__seccion dsm-confirmada__cuando">
            <div class="dsm-confirmada__dia">@FormatoDeCita.Dia(Cita.Fecha)</div>
            <div class="dsm-confirmada__fecha">@FormatoDeCita.FechaYHora(Cita.Fecha, Cita.Hora)</div>
            <div class="dsm-confirmada__tipo">@Cita.TipoDeVisita · @Cita.DuracionMin min · Dra. Selina Medina Castillo</div>
        </div>
        <div class="dsm-tarjeta__seccion dsm-lugar">
            <svg class="dsm-lugar__icono" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path>
                <circle cx="12" cy="9.5" r="2.5"></circle>
            </svg>
            <div class="dsm-lugar__texto">
                <div class="dsm-lugar__nombre">@Cita.Lugar</div>
                <div class="dsm-lugar__direccion">@Cita.Direccion</div>
            </div>
        </div>
    </div>

    <a href="@Calendario" class="btn dsm-boton-secundario dsm-confirmada__calendario">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3.5" y="5" width="17" height="15.5" rx="2.5"></rect>
            <path d="M3.5 10h17M8 3v4M16 3v4"></path>
        </svg>
        Agregar a mi calendario
    </a>

    @if (Cita.ConCorreo)
    {
        @Enlace
    }

    <div class="dsm-confirmada__pie">
        <a href="/" class="dsm-enlace-fuerte">Volver al inicio</a>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public CitaAgendadaEnLinea Cita { get; set; } = null!;

    // /c/<token>/calendario.ics, con el token del último segmento del Enlace de gestión: la ruta del endpoint, aunque la
    // URL base del enlace lleve una ruta propia.
    private string Calendario => $"/c/{Cita.EnlaceDeGestion.TrimEnd('/')[(Cita.EnlaceDeGestion.TrimEnd('/').LastIndexOf('/') + 1)..]}/calendario.ics";

    private RenderFragment Enlace => @<div class="dsm-enlace-de-gestion" role="group" aria-labelledby="guarda-este-enlace">
        <div class="dsm-enlace-de-gestion__encabezado">
            <svg class="dsm-enlace-de-gestion__icono" width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"></path>
                <path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"></path>
            </svg>
            <div class="dsm-enlace-de-gestion__texto">
                <h2 id="guarda-este-enlace" class="dsm-enlace-de-gestion__titulo">Guarda este enlace</h2>
                <p class="dsm-enlace-de-gestion__ayuda">Con él puedes reprogramar @FormatoDeCita.HastaAntes(Cita.UmbralDeReprogramacionMin) o cancelar en cualquier momento. No necesitas cuenta.</p>
            </div>
        </div>
        <p class="dsm-enlace-de-gestion__direccion">@Cita.EnlaceDeGestion</p>
    </div>;
}
