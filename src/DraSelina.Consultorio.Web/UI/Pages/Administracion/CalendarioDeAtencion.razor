@page "/admin/calendario"
@attribute [Authorize]
@rendermode InteractiveServer
@layout LayoutAdministracion
@implements IAsyncDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using DraSelina.Consultorio.Agenda.Contracts
@using DraSelina.Consultorio.BuildingBlocks.Contracts
@using DraSelina.Consultorio.Kernel
@using DraSelina.Consultorio.UI.Pages.Reserva
@inject IQueryHandler<MesDeAtencion, IReadOnlyList<DiaDeAtencion>> Consulta
@inject ICommandHandler<GuardarAgendaCustom, AgendaCustomGuardada> Guardar
@inject ICommandHandler<BorrarAgendaCustom, AgendaCustomBorrada> Borrar
@inject IQueryHandler<CitasFueraDelHorario, HorarioConCitasFuera> VistaPrevia
@inject IClock Reloj
@inject ILogger<CalendarioDeAtencion> Registro
@inject IJSRuntime JS

@*
    Calendario de atención (CAP-11, FR-13, UJ-3, UJ-6; entrada 6.1): el mes, con cada día como lo distingue la Agenda
    (no se atiende, horario especial o día abierto, con su motivo) y sus Tramos vigentes. Al tocar un día de hoy en
    adelante se abre el formulario de su horario propio, lleno con los Tramos que valen ese día y el motivo de su custom
    si tiene: Tramos que se agregan y se quitan (ninguno: ese día no se atiende) y motivo. Antes de guardar, o de quitar el
    horario propio (el día vuelve a la base, y se dice a qué Tramos), la vista previa CitasFueraDelHorario lista las Citas
    que quedarían fuera; el Administrador elige cancelar o conservar cada una (ListaDeCitasFuera, entrada 6.3) y la página
    manda esa lista con GuardarAgendaCustom o BorrarAgendaCustom. Si el comando responde que la lista ya no coincide, la
    vuelve a cargar con un aviso y conserva las elecciones de las Citas que siguen. Los días pasados se ven pero no se
    editan [ASSUMPTION].

    El mes va en la dirección (/admin/calendario?mes=2026-11); sin mes, o con uno que no se entiende, el mes de hoy (fecha
    local del consultorio, AD-17). Interactive Server (AD-11), con [Authorize]; la consulta y el comando llevan
    IRequiereAdministrador (AD-22). Una llamada a la vez (_ocupado). El motivo no va a registros. Textos `[ASSUMPTION: texto]`.
*@

<PageTitle>Calendario de atención · Administración</PageTitle>

<section class="dsm-contenedor dsm-atencion" aria-labelledby="calendario-de-atencion">
    <h1 id="calendario-de-atencion" class="dsm-titulo-de-estado">Calendario de atención</h1>
    <p class="dsm-cuerpo dsm-atencion__ayuda">@Ayuda</p>

    <div class="dsm-atencion__meses">
        <a class="dsm-agenda__control" href="@Direccion(_mes.AddMonths(-1))" aria-label="Mes anterior">‹</a>
        <h2 class="dsm-seccion dsm-atencion__mes-titulo">@FormatoDeCita.MesYAnio(_mes)</h2>
        <a class="dsm-agenda__control" href="@Direccion(_mes.AddMonths(1))" aria-label="Mes siguiente">›</a>
    </div>

    @if (_guardado is { } guardado)
    {
        <p class="dsm-aviso dsm-atencion__guardado" role="status">@guardado</p>
    }

    @if (_fallo)
    {
        <div class="dsm-aviso" role="alert">
            <p class="dsm-aviso__mensaje">@NoSeCargo</p>
        </div>
    }
    else if (_dias is { } dias)
    {
        <table class="dsm-atencion__tabla">
            <caption class="visually-hidden">@FormatoDeCita.MesYAnio(_mes)</caption>
            <thead>
                <tr>
                    @foreach (var nombre in DiasDeLaSemana)
                    {
                        <th scope="col">@nombre</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var semana in Semanas(dias))
                {
                    <tr>
                        @foreach (var dia in semana)
                        {
                            @if (dia is null)
                            {
                                <td class="dsm-atencion__dia dsm-atencion__dia--fuera"></td>
                            }
                            else
                            {
                                <td class="@ClaseDelDia(dia)" data-fecha="@Iso(dia.Fecha)">
                                    @if (dia.Fecha >= _hoy)
                                    {
                                        <button type="button" class="dsm-atencion__abrir" @onclick="() => Abrir(dia)"
                                                aria-label="@Etiqueta(dia)" aria-pressed="@(_seleccionada?.Fecha == dia.Fecha ? "true" : "false")">
                                            @ContenidoDelDia(dia)
                                        </button>
                                    }
                                    else
                                    {
                                        <div class="dsm-atencion__pasado">@ContenidoDelDia(dia)</div>
                                    }
                                </td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    }

    @* El editor del día va en un <dialog> modal (entrada 6.9): siempre está en la página, y el módulo JS lo abre con
       showModal() al tocar un día y lo cierra al guardar, quitar o cancelar. Esc lo cierra el navegador y avisa con close. *@
    <dialog @ref="_dialogo" class="dsm-atencion__dialogo" aria-labelledby="@(_quitando ? "quitar-del-dia" : "editor-del-dia")"
            @onclose="AlCerrarElDialogo">
    @if (_seleccionada is { } seleccionada)
    {
        <div class="dsm-atencion__cabeza-del-dialogo">
            <button type="button" class="btn dsm-boton-neutro dsm-atencion__cerrar" @onclick="Cerrar">Cerrar</button>
        </div>
        @if (_quitando)
        {
            <section class="dsm-atencion__editor dsm-atencion__quitar-panel" aria-labelledby="quitar-del-dia">
                <h2 id="quitar-del-dia" class="dsm-seccion" tabindex="-1">Quitar el horario propio del @FormatoDeCita.LargoEnFrase(seleccionada.Fecha)</h2>
                @if (_fuera is { } alQuitar)
                {
                    <p class="dsm-cuerpo dsm-atencion__vuelve">@VuelveA(alQuitar.Tramos)</p>
                    @if (alQuitar.Citas.Count > 0)
                    {
                        <ListaDeCitasFuera Citas="alQuitar.Citas" Elecciones="_elecciones" FaltaElegir="_faltaElegir" AlCambiar="AlElegir" />
                    }
                }
                @MensajeDeError()
                <div class="dsm-atencion__acciones">
                    <button type="button" class="btn btn-primary dsm-accion-principal dsm-atencion__confirmar-quitar"
                            disabled="@(_ocupado || _fuera is null)" @onclick="QuitarAsync">Quitar horario propio</button>
                    <button type="button" class="btn dsm-boton-neutro dsm-atencion__volver" @onclick="VolverAlEditor">Volver</button>
                </div>
            </section>
        }
        else
        {
            <form class="dsm-formulario dsm-atencion__editor" @onsubmit="GuardarAsync" aria-labelledby="editor-del-dia">
                <h2 id="editor-del-dia" class="dsm-seccion" tabindex="-1">Horario propio del @FormatoDeCita.LargoEnFrase(seleccionada.Fecha)</h2>
                <p class="dsm-cuerpo">Horario actual: @Descripcion(seleccionada)</p>

                <fieldset class="dsm-atencion__tramos">
                    <legend class="dsm-campo__etiqueta">Tramos</legend>
                    @for (var i = 0; i < _comando.Tramos.Count; i++)
                    {
                        var indice = i;
                        var tramo = _comando.Tramos[indice];
                        var propiedad = GuardarAgendaCustom.PropiedadDelTramo(indice);
                        <div class="dsm-atencion__tramo" data-tramo="@indice">
                            <div class="dsm-campo">
                                <label for="inicio-@indice" class="dsm-campo__etiqueta">Inicio</label>
                                <input id="inicio-@indice" type="time" class="dsm-campo__control" @bind="tramo.Inicio"
                                       aria-invalid="@Invalido(propiedad)" aria-describedby="@DescritoPor(propiedad)" />
                            </div>
                            <div class="dsm-campo">
                                <label for="fin-@indice" class="dsm-campo__etiqueta">Fin</label>
                                <input id="fin-@indice" type="time" class="dsm-campo__control" @bind="tramo.Fin"
                                       aria-invalid="@Invalido(propiedad)" aria-describedby="@DescritoPor(propiedad)" />
                            </div>
                            <button type="button" class="btn dsm-boton-neutro dsm-atencion__quitar" @onclick="() => Quitar(indice)">
                                Quitar<span class="visually-hidden"> el tramo @(indice + 1)</span>
                            </button>
                            @ErroresDe(propiedad)
                        </div>
                    }
                    @if (_comando.Tramos.Count == 0)
                    {
                        <p class="dsm-cuerpo dsm-atencion__sin-tramos">@SinTramos</p>
                    }
                    <button type="button" class="btn dsm-boton-neutro dsm-atencion__agregar" @onclick="Agregar">Agregar tramo</button>
                </fieldset>

                <div class="dsm-campo">
                    <label for="motivo" class="dsm-campo__etiqueta">Motivo</label>
                    <input id="motivo" class="dsm-campo__control" @bind="_comando.Motivo" autocomplete="off" placeholder="cirugía, vacaciones, sábado abierto"
                           aria-invalid="@Invalido(nameof(GuardarAgendaCustom.Motivo))" aria-describedby="@DescritoPor(nameof(GuardarAgendaCustom.Motivo))" />
                    @ErroresDe(nameof(GuardarAgendaCustom.Motivo))
                </div>

                @if (_fuera is { Citas.Count: > 0 } alGuardar)
                {
                    <ListaDeCitasFuera Citas="alGuardar.Citas" Elecciones="_elecciones" FaltaElegir="_faltaElegir" AlCambiar="AlElegir" />
                }

                @MensajeDeError()

                <div class="dsm-atencion__acciones">
                    <button type="submit" class="btn btn-primary dsm-accion-principal" disabled="@_ocupado">Guardar</button>
                    @if (seleccionada.ConCustom)
                    {
                        <button type="button" class="btn dsm-boton-neutro dsm-atencion__quitar-custom" disabled="@_ocupado"
                                @onclick="EmpezarAQuitarAsync">Quitar horario propio</button>
                    }
                    <button type="button" class="btn dsm-boton-neutro" @onclick="Cerrar">Cancelar</button>
                </div>
            </form>
        }
    }
    </dialog>
</section>

@code {
    public const string Ayuda = "Toca una fecha para darle su horario propio: recortarla, cerrarla o abrirla. Las demás siguen la semana tipo.";
    public const string NoSeCargo = "No se pudo cargar el calendario. Recarga la página.";
    public const string SinTramos = "Sin tramos, ese día no se atiende.";
    public const string CitasFuera = "La lista de citas cambió mientras la revisabas: revísala de nuevo. No se guardó nada.";
    public const string TramosEncimados = "Dos tramos se enciman. Revisa las horas.";
    public const string TramoCorto = "En cada tramo debe caber al menos una cita del tipo de consulta más corto.";
    public const string FechaPasada = "Esa fecha ya pasó.";
    public const string SinSesion = "Tu sesión terminó. Vuelve a entrar.";
    public const string NoSeGuardo = "No se pudo guardar. Intenta de nuevo.";
    public const string Normal = "Horario de la semana tipo";

    /// <summary>El módulo JS junto a la página que abre y cierra el diálogo del editor.</summary>
    public const string RutaDelModulo = "./UI/Pages/Administracion/CalendarioDeAtencion.razor.js";

    private static readonly string[] DiasDeLaSemana = ["Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom"];

    /// <summary>El mes pedido en la dirección, <c>yyyy-MM</c>; si falta o no se entiende, el de hoy.</summary>
    [SupplyParameterFromQuery(Name = "mes")]
    public string? MesPedido { get; set; }

    private readonly CancellationTokenSource _cierre = new();
    private DateOnly _hoy;
    private DateOnly _mes;
    private IReadOnlyList<DiaDeAtencion>? _dias;
    private bool _fallo;
    private DiaDeAtencion? _seleccionada;
    private GuardarAgendaCustom _comando = new();
    private Resultado? _resultado;
    private string? _guardado;
    private bool _ocupado;

    // La vista previa de las Citas que quedan fuera y los Tramos con que se pidió (al guardar); las elecciones por Cita.
    private HorarioConCitasFuera? _fuera;
    private List<TramoDeLaAgenda>? _tramosVistos;
    private Dictionary<CitaId, bool?> _elecciones = [];
    private bool _faltaElegir;
    private bool _quitando;

    // El <dialog> del editor, el módulo que lo abre y lo cierra, lo que tiene el foco (nulo: cerrado) y el día al que
    // vuelve el foco.
    private ElementReference _dialogo;
    private IJSObjectReference? _modulo;
    private string? _focoMostrado;
    private DateOnly? _diaDelFoco;

    /// <summary>La dirección del Calendario en un mes: <c>/admin/calendario?mes=2026-11</c>.</summary>
    public static string Direccion(DateOnly mes) =>
        $"/admin/calendario?mes={mes.ToString("yyyy-MM", CultureInfo.InvariantCulture)}";

    /// <summary>La marca de un día sin Tramos o con Agenda custom, con su motivo; nula en un día normal. La de la Agenda.</summary>
    public static string? Marca(DiaDeAtencion dia) => Agenda.Marca(dia.Tipo, dia.MotivoDeCustom);

    private static string Tramos(IEnumerable<TramoDeLaAgenda> tramos) =>
        string.Join(", ", tramos.Select(t => $"{FormatoDeCita.Hora(t.Inicio)} a {FormatoDeCita.Hora(t.Fin)}"));

    private static string Descripcion(DiaDeAtencion dia) =>
        string.Join(" · ", new[] { Marca(dia) ?? Normal, dia.Tramos.Count > 0 ? Tramos(dia.Tramos) : null }.OfType<string>());

    private static string Etiqueta(DiaDeAtencion dia) => $"{FormatoDeCita.Largo(dia.Fecha)}: {Descripcion(dia)}";

    private static string Iso(DateOnly fecha) => fecha.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private string ClaseDelDia(DiaDeAtencion dia) =>
        "dsm-atencion__dia"
        + (dia.Tramos.Count == 0 ? " dsm-atencion__dia--cerrado" : "")
        + (dia.ConCustom ? " dsm-atencion__dia--custom" : "")
        + dia.Tipo switch
        {
            TipoDeDia.CustomSinAtencion => " dsm-atencion__dia--no-se-atiende",
            TipoDeDia.HorarioEspecial => " dsm-atencion__dia--especial",
            TipoDeDia.DiaAbierto => " dsm-atencion__dia--abierto",
            _ => "",
        }
        + (dia.Fecha == _hoy ? " dsm-atencion__dia--hoy" : "")
        + (dia.Fecha < _hoy ? " dsm-atencion__dia--pasado" : "")
        + (_seleccionada?.Fecha == dia.Fecha ? " dsm-atencion__dia--elegido" : "");

    private static RenderFragment ContenidoDelDia(DiaDeAtencion dia) => __builder =>
    {
        <span class="dsm-atencion__numero" aria-hidden="true">@dia.Fecha.Day</span>
        @if (Marca(dia) is { } marca)
        {
            <span class="dsm-atencion__marca" aria-hidden="true">@marca</span>
        }
        @if (dia.Tramos.Count > 0)
        {
            <span class="dsm-atencion__horas" aria-hidden="true">@Tramos(dia.Tramos)</span>
        }
    };

    // De lunes a domingo; null antes del primer día y después del último.
    private static IEnumerable<DiaDeAtencion?[]> Semanas(IReadOnlyList<DiaDeAtencion> dias)
    {
        var celdas = new List<DiaDeAtencion?>();
        celdas.AddRange(Enumerable.Repeat<DiaDeAtencion?>(null, ((int)dias[0].Fecha.DayOfWeek + 6) % 7));
        celdas.AddRange(dias);
        while (celdas.Count % 7 != 0)
        {
            celdas.Add(null);
        }

        return celdas.Chunk(7);
    }

    protected override async Task OnParametersSetAsync()
    {
        _hoy = DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Reloj.UtcNow, ZonaDelConsultorio.Zona).DateTime);
        var mes = DateOnly.TryParseExact(MesPedido, "yyyy-MM", CultureInfo.InvariantCulture, DateTimeStyles.None, out var pedido)
            ? pedido
            : new DateOnly(_hoy.Year, _hoy.Month, 1);

        if (mes != _mes || _dias is null)
        {
            _mes = mes;
            Cerrar();
            _guardado = null;
            await CargarAsync();
        }
    }

    private async Task CargarAsync()
    {
        try
        {
            var resultado = await Consulta.HandleAsync(new MesDeAtencion(_mes.Year, _mes.Month), _cierre.Token);
            _fallo = !resultado.EsExito;
            _dias = resultado.EsExito ? resultado.Valor : null;
        }
        catch (Exception error) when (!(error is OperationCanceledException && _cierre.IsCancellationRequested))
        {
            // Una consulta que lanza no tumba el circuito; sin el motivo de ninguna custom (no va a registros).
            Registro.LogWarning(error, "El Calendario de atención no se pudo cargar");
            _fallo = true;
            _dias = null;
        }
    }

    private void Abrir(DiaDeAtencion dia)
    {
        _seleccionada = dia;
        _diaDelFoco = dia.Fecha;
        _resultado = null;
        _guardado = null;
        OlvidarLaVista();
        _comando = new GuardarAgendaCustom
        {
            Fecha = dia.Fecha,
            Motivo = dia.MotivoDeCustom,
            Tramos = [.. dia.Tramos.Select(t => new TramoAGuardar { Inicio = t.Inicio, Fin = t.Fin })],
        };
    }

    private void Cerrar()
    {
        _seleccionada = null;
        _resultado = null;
        OlvidarLaVista();
    }

    private void OlvidarLaVista()
    {
        _fuera = null;
        _tramosVistos = null;
        _elecciones = [];
        _faltaElegir = false;
        _quitando = false;
    }

    private void Agregar() => _comando.Tramos.Add(new TramoAGuardar());

    private void Quitar(int indice)
    {
        _comando.Tramos.RemoveAt(indice);
        // Los errores de los Tramos van por posición: al quitar uno ya no corresponden.
        _resultado = null;
    }

    private async Task GuardarAsync()
    {
        if (_ocupado || _seleccionada is null)
        {
            return;
        }

        _ocupado = true;
        try
        {
            _resultado = null;

            // Con Tramos completos, primero la vista previa; con Tramos incompletos o al revés, el comando dice qué falta.
            if (TramosDelFormulario() is { } tramos && (_fuera is null || !_tramosVistos!.SequenceEqual(tramos)))
            {
                var vista = await VistaPrevia.HandleAsync(CitasFueraDelHorario.AlGuardar(_seleccionada.Fecha, tramos), _cierre.Token);
                if (vista.EsExito)
                {
                    MostrarLaVista(vista.Valor, tramos);
                    if (vista.Valor.Citas.Count > 0)
                    {
                        // Que el Administrador elija; el siguiente "Guardar" manda la lista.
                        return;
                    }
                }
            }

            if (!TodasElegidas())
            {
                return;
            }

            _comando.Citas = Decisiones();
            var resultado = await Guardar.HandleAsync(_comando, _cierre.Token);
            if (resultado.EsExito)
            {
                _guardado = (resultado.Valor.SinCambios
                    ? $"El {FormatoDeCita.LargoEnFrase(resultado.Valor.Fecha)} ya tenía ese horario."
                    : $"Se guardó el horario propio del {FormatoDeCita.LargoEnFrase(resultado.Valor.Fecha)}.") + Cancelaciones(_comando.Citas);
                Cerrar();
                await CargarAsync();
                return;
            }

            _resultado = resultado;
            if (resultado.Codigo == CodigosDeAgenda.CitasFuera && TramosDelFormulario() is { } vistos)
            {
                await RecargarLaVistaAsync(CitasFueraDelHorario.AlGuardar(_seleccionada.Fecha, vistos), vistos);
            }
        }
        catch (Exception error) when (!(error is OperationCanceledException && _cierre.IsCancellationRequested))
        {
            Registro.LogWarning(error, "El horario propio no se pudo guardar");
            _resultado = Resultado.Fallo("calendario.error");
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task EmpezarAQuitarAsync()
    {
        if (_ocupado || _seleccionada is null)
        {
            return;
        }

        _ocupado = true;
        try
        {
            OlvidarLaVista();
            _resultado = null;
            _quitando = true;
            await RecargarLaVistaAsync(CitasFueraDelHorario.AlQuitar(_seleccionada.Fecha), tramos: null);
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task QuitarAsync()
    {
        if (_ocupado || _seleccionada is null || _fuera is null || !TodasElegidas())
        {
            return;
        }

        _ocupado = true;
        try
        {
            var decisiones = Decisiones();
            var resultado = await Borrar.HandleAsync(new BorrarAgendaCustom { Fecha = _seleccionada.Fecha, Citas = decisiones }, _cierre.Token);
            if (resultado.EsExito)
            {
                _guardado = $"El {FormatoDeCita.LargoEnFrase(resultado.Valor.Fecha)} volvió a la semana tipo." + Cancelaciones(decisiones);
                Cerrar();
                await CargarAsync();
                return;
            }

            _resultado = resultado;
            if (resultado.Codigo == CodigosDeAgenda.CitasFuera)
            {
                await RecargarLaVistaAsync(CitasFueraDelHorario.AlQuitar(_seleccionada.Fecha), tramos: null);
            }
        }
        catch (Exception error) when (!(error is OperationCanceledException && _cierre.IsCancellationRequested))
        {
            Registro.LogWarning(error, "El horario propio no se pudo quitar");
            _resultado = Resultado.Fallo("calendario.error");
        }
        finally
        {
            _ocupado = false;
        }
    }

    private void VolverAlEditor()
    {
        OlvidarLaVista();
        _resultado = null;
    }

    private void AlElegir() => _faltaElegir = false;

    // Pide la vista previa otra vez; si no vuelve, lo dice sin perder lo que ya se mostraba.
    private async Task RecargarLaVistaAsync(CitasFueraDelHorario consulta, List<TramoDeLaAgenda>? tramos)
    {
        try
        {
            var vista = await VistaPrevia.HandleAsync(consulta, _cierre.Token);
            if (vista.EsExito)
            {
                MostrarLaVista(vista.Valor, tramos);
                return;
            }
        }
        catch (Exception error) when (!(error is OperationCanceledException && _cierre.IsCancellationRequested))
        {
            Registro.LogWarning(error, "Las citas que quedan fuera no se pudieron revisar");
        }

        _resultado ??= Resultado.Fallo("calendario.error");
    }

    // Conserva la elección de las Citas que siguen en la lista; las nuevas, con la preselección del Assumption de RN-10:
    // las del Consultorio en conservar, las en línea sin elegir.
    private void MostrarLaVista(HorarioConCitasFuera vista, List<TramoDeLaAgenda>? tramos)
    {
        _fuera = vista;
        _tramosVistos = tramos;
        _elecciones = vista.Citas.ToDictionary(
            c => c.CitaId,
            c => _elecciones.TryGetValue(c.CitaId, out var antes) && antes is not null ? antes : (c.DelConsultorio ? false : (bool?)null));
        _faltaElegir = false;
    }

    private bool TodasElegidas()
    {
        _faltaElegir = _fuera is { } vista && vista.Citas.Any(c => _elecciones.GetValueOrDefault(c.CitaId) is null);
        return !_faltaElegir;
    }

    private List<DecisionSobreCita> Decisiones() =>
        _fuera is { } vista
            ? [.. vista.Citas.Select(c => new DecisionSobreCita { CitaId = c.CitaId, Cancelar = _elecciones[c.CitaId] == true })]
            : [];

    // Los Tramos del formulario si todos están completos y con el inicio antes del fin; si no, nulo.
    private List<TramoDeLaAgenda>? TramosDelFormulario() =>
        _comando.Tramos.All(t => t.Inicio is { } inicio && t.Fin is { } fin && inicio < fin)
            ? [.. _comando.Tramos.Select(t => new TramoDeLaAgenda(t.Inicio!.Value, t.Fin!.Value))]
            : null;

    // Lo que pasa con las Citas elegidas para cancelar; la disculpa solo llega a quien tiene correo (RN-30), a los demás
    // se les avisa a mano. Con la vista previa que se mandó (_fuera), antes de cerrar.
    private string Cancelaciones(IReadOnlyCollection<DecisionSobreCita> decisiones)
    {
        var canceladas = decisiones.Where(d => d.Cancelar).Select(d => d.CitaId).ToHashSet();
        var sinCorreo = _fuera?.Citas.Count(c => canceladas.Contains(c.CitaId) && c.SinCorreo) ?? 0;
        return (canceladas.Count, sinCorreo) switch
        {
            (0, _) => "",
            (1, 0) => " La cita elegida se cancela en unos instantes y su paciente recibe la disculpa.",
            (1, _) => " La cita elegida se cancela en unos instantes; su paciente no tiene correo: avísale a mano.",
            (var n, 0) => $" Las {n} citas elegidas se cancelan en unos instantes y sus pacientes reciben la disculpa.",
            (var n, var s) when s == n => $" Las {n} citas elegidas se cancelan en unos instantes; sus pacientes no tienen correo: avísales a mano.",
            (var n, _) => $" Las {n} citas elegidas se cancelan en unos instantes; los pacientes con correo reciben la disculpa y a los demás avísales a mano.",
        };
    }

    private static string VuelveA(IReadOnlyList<TramoDeLaAgenda> tramos) =>
        tramos.Count == 0
            ? "El día vuelve a la semana tipo, que no atiende ese día."
            : $"El día vuelve a la semana tipo: {Tramos(tramos)}.";

    private RenderFragment? MensajeDeError() => MensajeGeneral() is { } mensaje
        ? __builder =>
        {
            <div class="dsm-aviso dsm-atencion__error" role="alert">
                <p class="dsm-aviso__mensaje">@mensaje</p>
            </div>
        }
        : null;

    private string? MensajeGeneral()
    {
        if (_resultado is null || _resultado.EsExito)
        {
            return null;
        }

        return _resultado.Forma switch
        {
            FormaDeResultado.NoAutorizado => SinSesion,
            FormaDeResultado.Invalido => _resultado.Errores.TryGetValue(nameof(GuardarAgendaCustom.Fecha), out var fecha) ? fecha[0] : null,
            _ => _resultado.Codigo switch
            {
                CodigosDeAgenda.CitasFuera => CitasFuera,
                CodigosDeAgenda.TramosEncimados => TramosEncimados,
                CodigosDeAgenda.TramoCorto => TramoCorto,
                CodigosDeAgenda.FechaPasada => FechaPasada,
                _ => NoSeGuardo,
            },
        };
    }

    private IReadOnlyList<string> Errores(string propiedad) =>
        _resultado?.Errores.TryGetValue(propiedad, out var errores) == true ? errores : [];

    private string? Invalido(string propiedad) => Errores(propiedad).Count > 0 ? "true" : null;

    private string? DescritoPor(string propiedad) => Errores(propiedad).Count > 0 ? $"error-{Id(propiedad)}" : null;

    private static string Id(string propiedad) => propiedad.Replace("[", "-").Replace("]", "");

    private RenderFragment? ErroresDe(string propiedad)
    {
        var errores = Errores(propiedad);
        if (errores.Count == 0)
        {
            return null;
        }

        return __builder =>
        {
            <p id="error-@Id(propiedad)" class="dsm-campo__error">@string.Join(" ", errores)</p>
        };
    }

    // Lo que lleva el foco dentro del diálogo: el título de quitar, la lista de Citas fuera cuando aparece (cierra el foco
    // pendiente de la 6.3) o el título del día. Nulo con el diálogo cerrado.
    private string? FocoDelDialogo() =>
        _seleccionada is null ? null
        : _quitando ? "#quitar-del-dia"
        : _fuera is { Citas.Count: > 0 } ? ".dsm-citas-fuera__titulo"
        : "#editor-del-dia";

    // Abre o cierra el <dialog> cuando cambia si hay un día elegido, y mueve el foco cuando cambia lo que se muestra
    // adentro. El módulo se importa la primera vez que hace falta.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var foco = FocoDelDialogo();
        if (foco == _focoMostrado)
        {
            return;
        }

        _focoMostrado = foco;
        var abierto = foco is not null;
        try
        {
            _modulo ??= await JS.InvokeAsync<IJSObjectReference>("import", _cierre.Token, RutaDelModulo);
            if (abierto)
            {
                await _modulo.InvokeVoidAsync("abrir", _cierre.Token, _dialogo, foco);
            }
            else
            {
                await _modulo.InvokeVoidAsync("cerrar", _cierre.Token, _dialogo, _diaDelFoco is { } dia ? Iso(dia) : null);
            }
        }
        catch (Exception error) when (error is JSDisconnectedException || (error is OperationCanceledException && _cierre.IsCancellationRequested))
        {
            // El circuito se fue o la página se desechó: no hay diálogo que abrir ni cerrar.
        }
        catch (JSException error)
        {
            // El módulo no cargó: no tumba el circuito; queda en los registros.
            Registro.LogWarning(error, "El diálogo del Calendario de atención no se pudo abrir o cerrar");
        }
    }

    // Esc (o el navegador) cerró el diálogo: se olvida el día, como con Cancelar. Si ya se cerró desde aquí, nada.
    private void AlCerrarElDialogo()
    {
        if (_seleccionada is not null)
        {
            Cerrar();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cierre.Cancel();
        _cierre.Dispose();
        if (_modulo is not null)
        {
            try
            {
                await _modulo.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // El circuito ya no existe; el módulo se fue con él.
            }
        }
    }
}
