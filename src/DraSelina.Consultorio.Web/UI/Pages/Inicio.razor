@page "/"
@layout LayoutSitio
@using DraSelina.Consultorio.Agenda.Contracts
@using DraSelina.Consultorio.BuildingBlocks.Contracts
@using DraSelina.Consultorio.Contenido.Contracts
@using DraSelina.Consultorio.UI.Pages.Sitio
@using Microsoft.AspNetCore.Http
@inject IQueryHandler<SemanaDeAtencion, IReadOnlyList<DiaDeLaBase>> Horario
@inject IContenidoApi Contenido

@*
    Sitio · Inicio (CAP-21; mockups SitioInicio y SitioMovil): una sola página con secciones y navegación por anclas
    (Decision de la épica 7, 2026-11-17). Los días y horas salen de la Agenda base por SemanaDeAtencion, agrupados por
    HorarioAgrupado; lugar, dirección, mapa y WhatsApp, de Contenido (AD-15). SSR estático sin más script que el JSON-LD
    (AD-11); el mapa es el iframe de Google Maps, la única excepción con nombre a "Nada de terceros" (README). La
    portada, Sobre mí y Padecimientos muestran los datos de la doctora de Contenido; lo que es nulo se ve como Pendiente
    (entrada 7.2). Sin testimonios ni fotos de antes/después (FR-27): el retrato es un recuadro con las iniciales.
    Termina con la franja "Agenda tu consulta en menos de un minuto" (entrada 7.3). Título, description y el JSON-LD
    Physician para buscadores (FR-29; entrada 7.4). Los íconos de lugar, reloj y WhatsApp de Ubicación son los del
    mockup (entrada 7.6).
*@

<PageTitle>@TextosDelSitio.TituloDeInicio(Contenido)</PageTitle>

<HeadContent>
    <meta name="description" content="@TextosDelSitio.DescriptionDeInicio(Contenido)" />
    @* Razor no deja escribir <script> en un componente: el bloque va entero como MarkupString. Es JSON con <, > y &
       escapados (FichaDelConsultorio), datos y no código: la única excepción a "Sin script" (README, AD-11). *@
    @((MarkupString)$"<script type=\"application/ld+json\">{_ficha}</script>")
</HeadContent>

<section id="inicio" class="dsm-portada">
    <svg class="dsm-portada__ola" viewBox="0 0 390 110" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="dsm-portada__ola-clara" d="M0 0 H390 V38 C320 70 250 18 170 40 C100 60 50 30 0 52 Z" />
        <path class="dsm-portada__ola-oscura" d="M0 0 H390 V18 C330 46 260 6 190 22 C120 38 60 10 0 28 Z" />
    </svg>
    <div class="dsm-contenedor dsm-portada__fila">
        <div class="dsm-portada__texto">
            <div class="dsm-rotulo">@Doctora.Especialidad</div>
            <h1 class="dsm-display">@Doctora.Nombre</h1>
            <p class="dsm-cuerpo dsm-portada__frase">
                Diagnóstico y tratamiento de lesiones y enfermedades de huesos, articulaciones, músculos y ligamentos.
            </p>
            <div class="dsm-portada__acciones">
                <a href="/reservar" class="btn btn-primary dsm-accion-principal dsm-portada__accion">Agendar cita en línea<svg class="dsm-portada__icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
                @if (EnlaceDeWhatsApp.HayNumero(Contenido.WhatsApp))
                {
                    <EnlaceDeWhatsApp WhatsApp="@Contenido.WhatsApp" Clase="btn dsm-boton-secundario dsm-portada__whatsapp"><svg class="dsm-portada__icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20l1.2-4.2A8.5 8.5 0 1 1 20 11.5z" /></svg>WhatsApp</EnlaceDeWhatsApp>
                }
                else
                {
                    <p class="dsm-portada__sin-whatsapp"><MensajeDeWhatsApp WhatsApp="@Contenido.WhatsApp" /></p>
                }
            </div>
            <ul class="dsm-portada__cedulas">
                <li>Céd. Prof. @Doctora.CedulaProfesional</li>
                <li>Céd. Especialidad @Doctora.CedulaDeEspecialidad</li>
                <li>Certificada por el @Doctora.ConsejoQueCertifica</li>
            </ul>
        </div>
        <div class="dsm-portada__retrato-marco">
            <div class="dsm-portada__retrato" aria-hidden="true">SM</div>
        </div>
    </div>
</section>

<section id="sobre-mi" class="dsm-contenedor dsm-seccion-del-sitio dsm-sobre-mi" aria-labelledby="titulo-sobre-mi">
    <div class="dsm-sobre-mi__encabezado">
        <div class="dsm-rotulo">Sobre mí</div>
        <h2 id="titulo-sobre-mi" class="dsm-seccion-del-sitio__titulo">Formación y certificaciones</h2>
    </div>
    <div class="dsm-sobre-mi__cuerpo">
        @if (Doctora.Semblanza is { } semblanza)
        {
            <p class="dsm-cuerpo dsm-sobre-mi__semblanza">@semblanza</p>
        }
        else
        {
            <p class="dsm-sobre-mi__semblanza"><Pendiente Que="semblanza breve escrita con Selina: trayectoria, experiencia y cómo atiende a sus pacientes" /></p>
        }
        <dl class="dsm-sobre-mi__datos">
            <div class="dsm-sobre-mi__dato">
                <dt>Formación</dt>
                <dd>
                    @if (Doctora.Formacion is { } formacion)
                    {
                        @formacion
                    }
                    else
                    {
                        <Pendiente Que="universidad" />
                    }
                </dd>
            </div>
            <div class="dsm-sobre-mi__dato">
                <dt>Certificación</dt>
                <dd>@Doctora.ConsejoQueCertifica, @Doctora.RegistroDeCertificacion</dd>
            </div>
            <div class="dsm-sobre-mi__dato">
                <dt>Cédula profesional</dt>
                <dd>@Doctora.CedulaProfesional</dd>
            </div>
            <div class="dsm-sobre-mi__dato">
                <dt>Cédula de especialidad</dt>
                <dd>@Doctora.CedulaDeEspecialidad</dd>
            </div>
        </dl>
        @if (Doctora.Afiliaciones is { } afiliaciones)
        {
            <p class="dsm-sobre-mi__afiliaciones">@afiliaciones</p>
        }
        else
        {
            <p class="dsm-sobre-mi__afiliaciones"><Pendiente Que="afiliaciones hospitalarias" /></p>
        }
    </div>
</section>

<section id="padecimientos" class="dsm-padecimientos" aria-labelledby="titulo-padecimientos">
    <div class="dsm-contenedor dsm-seccion-del-sitio dsm-padecimientos__contenido">
        <div class="dsm-padecimientos__encabezado">
            <div class="dsm-rotulo">Padecimientos y tratamientos</div>
            <h2 id="titulo-padecimientos" class="dsm-seccion-del-sitio__titulo">¿En qué te puedo ayudar?</h2>
        </div>
        <div class="dsm-padecimientos__rejilla">
            @foreach (var padecimiento in Doctora.Padecimientos)
            {
                <article class="dsm-padecimiento">
                    <h3 class="dsm-padecimiento__nombre">@padecimiento.Nombre</h3>
                    @if (padecimiento.Descripcion is { } descripcion)
                    {
                        <p class="dsm-padecimiento__descripcion">@descripcion</p>
                    }
                    else
                    {
                        <p class="dsm-padecimiento__descripcion"><Pendiente Que="descripción breve escrita con Selina" /></p>
                    }
                </article>
            }
        </div>
    </div>
</section>

<section id="ubicacion" class="dsm-contenedor dsm-seccion-del-sitio dsm-ubicacion" aria-labelledby="titulo-ubicacion">
    <div class="dsm-ubicacion__datos">
        <div class="dsm-rotulo">Ubicación y horarios</div>
        <h2 id="titulo-ubicacion" class="dsm-seccion-del-sitio__titulo">@Consultorio.Lugar</h2>

        <div class="dsm-ubicacion__dato">
            <svg class="dsm-ubicacion__icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
            <div class="dsm-ubicacion__texto">
                <span>@Consultorio.Direccion, @Consultorio.Ciudad</span>
            </div>
        </div>

        <div class="dsm-ubicacion__dato">
            <svg class="dsm-ubicacion__icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
            <div class="dsm-ubicacion__texto">
                @if (_grupos.Count == 0)
                {
                    <span>Por ahora no hay horarios en línea.</span>
                }
                else
                {
                    <ul class="dsm-ubicacion__horario">
                        @foreach (var grupo in _grupos)
                        {
                            <li><span class="dsm-ubicacion__dias">@grupo.Dias</span> <span>@grupo.Horas</span></li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="dsm-ubicacion__dato">
            <svg class="dsm-ubicacion__icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20l1.2-4.2A8.5 8.5 0 1 1 20 11.5z" /></svg>
            <div class="dsm-ubicacion__texto">
                <span class="dsm-ubicacion__etiqueta">WhatsApp</span>
                @if (EnlaceDeWhatsApp.HayNumero(Contenido.WhatsApp))
                {
                    <EnlaceDeWhatsApp WhatsApp="@Contenido.WhatsApp" Clase="dsm-ubicacion__whatsapp" />
                }
                else
                {
                    <span><MensajeDeWhatsApp WhatsApp="@Contenido.WhatsApp" /></span>
                }
            </div>
        </div>

        @if (Consultorio.EnlaceDelMapa is { } enlace)
        {
            <a href="@enlace" class="dsm-ubicacion__como-llegar">Cómo llegar</a>
        }
    </div>

    @if (Consultorio.MapaIncrustado is { } mapa)
    {
        <iframe class="dsm-ubicacion__mapa" src="@mapa" loading="lazy" title="Mapa del consultorio"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
    }
</section>

<section class="dsm-franja" aria-labelledby="titulo-franja">
    <div class="dsm-contenedor dsm-franja__fila">
        <div class="dsm-franja__texto">
            <h2 id="titulo-franja" class="dsm-franja__titulo">Agenda tu consulta en menos de un minuto</h2>
            <p class="dsm-franja__frase">
                Elige el día y la hora que te acomoden. Sin llamadas ni cuentas; tu cita queda confirmada al instante.
            </p>
        </div>
        <a href="/reservar" class="btn dsm-franja__agendar">Agendar cita</a>
    </div>
</section>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private IReadOnlyList<GrupoDeHorario> _grupos = [];

    private string _ficha = "";

    private CancellationToken Cancelacion => HttpContext?.RequestAborted ?? CancellationToken.None;

    private DatosDelConsultorio Consultorio => Contenido.DatosDelConsultorio;

    private DatosDeLaDoctora Doctora => Contenido.DatosDeLaDoctora;

    // La dirección del sitio con el esquema y el host de la petición (Gerardo, 2026-11-17).
    private string UrlDelSitio =>
        HttpContext?.Request is { } peticion ? $"{peticion.Scheme}://{peticion.Host}/" : "/";

    protected override async Task OnInitializedAsync()
    {
        var horario = await Horario.HandleAsync(new SemanaDeAtencion(), Cancelacion);
        IReadOnlyList<DiaDeLaBase> dias = horario.EsExito ? horario.Valor : [];
        _grupos = HorarioAgrupado.Agrupar(dias);
        _ficha = FichaDelConsultorio.JsonLd(Doctora, Consultorio, Contenido.WhatsApp, dias, UrlDelSitio);
    }
}
