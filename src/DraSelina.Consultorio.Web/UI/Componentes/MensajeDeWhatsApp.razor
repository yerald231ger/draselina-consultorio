@*
    "Escríbenos por WhatsApp" con el número del consultorio cuando Contenido lo tiene (enlace a la conversación), y
    sin número mientras no se conozca (Gerardo, 2026-11-02). Un enlace externo permitido (EXPERIENCE.md).
*@

@if (EnlaceDeWhatsApp.HayNumero(WhatsApp))
{
    <text>Escríbenos por WhatsApp al </text><EnlaceDeWhatsApp WhatsApp="@WhatsApp" Clase="dsm-enlace-en-texto" /><text> y te ayudamos.</text>
}
else
{
    <text>Escríbenos por WhatsApp y te ayudamos.</text>
}

@code {
    /// <summary>El WhatsApp de <c>IContenidoApi</c>, a 10 dígitos; nulo o vacío si no se conoce.</summary>
    [Parameter]
    public string? WhatsApp { get; set; }
}
