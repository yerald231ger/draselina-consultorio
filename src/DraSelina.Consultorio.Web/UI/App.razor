@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="es-MX">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Solo hojas propias, servidas por MapStaticAssets con su huella. Sin blazor.web.js ni ningún otro script fuera de
       la administración: el sitio y la reserva se entregan en SSR estático, cada página completa y sin conexión interactiva
       (AD-11). *@
    <link rel="stylesheet" href="@Assets["lib/bootstrap/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["css/consultorio.css"]" />
    <HeadOutlet />
</head>

<body>
    @if (Pagina is null)
    {
        <Routes />
    }
    else
    {
        <LayoutView Layout="typeof(LayoutPublico)">
            <DynamicComponent Type="Pagina" />
        </LayoutView>
    }
    @if (EsAdministracion)
    {
        @* Solo la administración abre un circuito de Interactive Server (AD-11): el script va solo bajo /admin, y no en
           inicio de sesión, segundo factor ni enrolamiento (/admin/entrar), que son SSR estático. *@
        <script src="@Assets["_framework/blazor.web.js"]"></script>
    }
</body>

</html>

@code {
    /// <summary>
    /// Una página que se pinta sin pasar por las rutas, con el layout del sitio. Solo la pasa el host cuando responde
    /// sin llegar a la página pedida (la de <see cref="DemasiadosIntentos"/>); nula, App pinta la ruta.
    /// </summary>
    [Parameter]
    public Type? Pagina { get; set; }

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    // App siempre se pinta en la petición, con su HttpContext.
    private bool EsAdministracion =>
        HttpContext?.Request.Path is { } ruta
        && ruta.StartsWithSegments("/admin")
        && !ruta.StartsWithSegments("/admin/entrar");
}
