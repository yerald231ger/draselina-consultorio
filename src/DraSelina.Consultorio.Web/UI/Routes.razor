@using Microsoft.AspNetCore.Components.Authorization

@*
    Las rutas del sitio. AuthorizeRouteView respeta [Authorize] de las páginas de administración; en SSR estático la
    redirección a /admin/entrar la hace antes el middleware de autorización, con la cookie de Identity (AD-22).
*@
<Router AppAssembly="typeof(Routes).Assembly">
    <Found Context="ruta">
        <AuthorizeRouteView RouteData="ruta" DefaultLayout="typeof(LayoutPublico)">
            <NotAuthorized>
                <section class="dsm-contenedor dsm-entrar">
                    <p class="dsm-cuerpo">Para ver esta página, <a href="/admin/entrar">entra con tu cuenta</a>.</p>
                </section>
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
</Router>
