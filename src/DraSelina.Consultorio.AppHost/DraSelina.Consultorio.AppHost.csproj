<Project Sdk="Aspire.AppHost.Sdk/17.0.0">

  <!-- AppHost de Aspire: un solo comando levanta PostgreSQL, corre el MigrationService y después la web. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- ASPIRE010 avisa que no se usa el paquete de la CLI `aspire` (AspireUseCliBundle=false). La CLI no está
         instalada y no hace falta: el panel y el orquestador llegan por NuGet y `dotnet run` arranca todo. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <!-- TEMPORAL (Aspire 17, 2026-11-19): ASPIRE012 avisa que Aspire.AppHost.Sdk es obsoleto y CS0618 que
         AddProject<T> lo es (lo reemplaza AddDotnetProject del paquete Aspire.Hosting.Dotnet). Se quitan al migrar
         a Microsoft.NET.Sdk. -->
    <NoWarn>$(NoWarn);ASPIRE012;CS0618</NoWarn>
    <!-- Los parámetros secretos (la contraseña inicial del Administrador) se guardan en user-secrets, fuera del
         repositorio: dotnet user-secrets set "Parameters:clave-administrador" "..." -->
    <UserSecretsId>5d0c8f0e-3a8b-4d7e-9f61-2c4b7a1e9d35</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.MailPit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DraSelina.Consultorio.Web\DraSelina.Consultorio.Web.csproj" />
    <ProjectReference Include="..\DraSelina.Consultorio.MigrationService\DraSelina.Consultorio.MigrationService.csproj" />
  </ItemGroup>

</Project>
