<Project Sdk="Aspire.AppHost.Sdk/13.6.0">

  <!-- AppHost de Aspire: un solo comando levanta PostgreSQL, corre el MigrationService y después la web. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- ASPIRE010 avisa que no se usa el paquete de la CLI `aspire` (AspireUseCliBundle=false). La CLI no está
         instalada y no hace falta: el panel y el orquestador llegan por NuGet y `dotnet run` arranca todo. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.MailPit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DraSelina.Consultorio.Web\DraSelina.Consultorio.Web.csproj" />
    <ProjectReference Include="..\DraSelina.Consultorio.MigrationService\DraSelina.Consultorio.MigrationService.csproj" />
  </ItemGroup>

</Project>
