+using DraSelina.Consultorio.BuildingBlocks.Contracts;
+using DraSelina.Consultorio.Kernel;
+using Microsoft.EntityFrameworkCore;
+
+namespace DraSelina.Consultorio.IntegrationTests.Pruebas;
+
+/// <summary>Consulta de prueba: el texto de una <see cref="Anotacion"/>.</summary>
+public sealed class LeerAnotacion : IQuery<string>
+{
+    public Guid Id { get; set; }
+}
+
+/// <summary>Un handler por consulta: lee sin seguimiento, proyecta y nunca guarda.</summary>
+public static class LeerAnotacionHandler
+{
+    public static async Task<Resultado<string>> Handle(LeerAnotacion consulta, PruebasDbContext db, CancellationToken cancelacion)
+    {
+        var texto = await db.Anotaciones.AsNoTracking()
+            .Where(a => a.Id == consulta.Id)
+            .Select(a => a.Texto)
+            .SingleOrDefaultAsync(cancelacion);
+
+        return texto is null ? Resultado.Fallo(CodigosDeAnotacion.NoExiste).Como<string>() : texto;
+    }
+}
+
+/// <summary>Un comando al que nadie le escribió handler.</summary>
+public sealed class ComandoSinHandler : ICommand<int>;
