<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Pruebas de los componentes de UI/ con bUnit: se pintan en memoria, en SSR estático o en interactivo, sin
       navegador, sin host y sin base de datos. No necesitan Docker. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="bunit" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DraSelina.Consultorio.Web\DraSelina.Consultorio.Web.csproj" />
  </ItemGroup>

</Project>
